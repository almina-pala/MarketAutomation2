<Window x:Class="MarketAutomation2.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Market Automation"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource AppHeader}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White"
                            CornerRadius="10"
                            Width="52" Height="52"
                            Margin="0,0,18,0">
                        <TextBlock Text="🏪"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtMarketName"
                                   Text="MARKET AUTOMATION"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Market / Kasa Otomasyon Sistemi"
                                   FontSize="14"
                                   Foreground="#BBDEFB"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menu Tiles -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="40,32">
            <Grid HorizontalAlignment="Center"
      MaxWidth="900">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- KASA -->
                <Button Grid.Row="0"
            Grid.Column="0"
            Margin="12"
            Height="180"
            Style="{StaticResource MenuTileButton}"
            Click="CashRegisterButton_Click">

                    <StackPanel>
                        <TextBlock Text="🛒"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                        <TextBlock Text="KASA"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Satış ve ödeme işlemleri"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                </Button>


                <!-- ÜRÜN YÖNETİMİ -->
                <Button Grid.Row="0"
            Grid.Column="1"
            Margin="12"
            Height="180"
            Style="{StaticResource MenuTileButton}"
            Click="ProductManagementButton_Click">

                    <StackPanel>
                        <TextBlock Text="📦"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                        <TextBlock Text="ÜRÜN YÖNETİMİ"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Ürün ekleme, düzenleme, stok"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                </Button>


                <!-- KATEGORİ YÖNETİMİ -->
                <Button Grid.Row="1"
            Grid.Column="0"
            Margin="12"
            Height="180"
            Style="{StaticResource MenuTileButton}"
            Click="CategoryManagementButton_Click">

                    <StackPanel>
                        <TextBlock Text="📁"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                        <TextBlock Text="KATEGORİ YÖNETİMİ"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Kategori ekleme, düzenleme ve silme"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                </Button>


                <!-- RAPORLAR -->
                <Button Grid.Row="1"
            Grid.Column="1"
            Margin="12"
            Height="180"
            Style="{StaticResource MenuTileButton}"
            Click="ReportsButton_Click">

                    <StackPanel>
                        <TextBlock Text="📊"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                        <TextBlock Text="RAPORLAR"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Satış ve stok raporları"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                </Button>


                <!-- AYARLAR -->
                <Button Grid.Row="1"
            Grid.Column="2"
            Margin="12"
            Height="180"
            Style="{StaticResource MenuTileButton}"
            Click="SettingsButton_Click">

                    <StackPanel>
                        <TextBlock Text="⚙"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                        <TextBlock Text="AYARLAR"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Sistem ve kasa ayarları"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                </Button>

            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock Text="© 2026 Market Automation"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"/>

                <Button Content="ÇIKIŞ"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        Padding="24,10"
                        Click="ExitButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
