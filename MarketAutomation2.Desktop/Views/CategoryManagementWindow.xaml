<Window x:Class="MarketAutomation2.Desktop.Views.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategori Yönetimi"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="KATEGORİ YÖNETİMİ"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <Grid Grid.Row="1"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                     Height="45"
                     VerticalContentAlignment="Center"
                     FontSize="16"
                     Padding="10"
                     Margin="0,0,10,0"/>

            <Button Grid.Column="1"
                    Content="EKLE"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Command="{Binding AddCategoryCommand}"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Categories}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  FontSize="15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="80"/>

                <DataGridTextColumn Header="Kategori Adı"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="İşlemler"
                                        Width="220">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <Button Content="Düzenle"
                                        Margin="5"
                                        Padding="10,5"
                                        Command="{Binding DataContext.EditCommand,
                                                  RelativeSource={
                                                  RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>

                                <Button Content="Sil"
                                        Margin="5"
                                        Padding="10,5"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={
                                                  RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>

                            </StackPanel>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>