<Window x:Class="MarketAutomation2.Desktop.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raporlar"
        Height="750"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <StackPanel>

                <TextBlock Text="📊 Raporlar"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="Satış ve stok bilgileri"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Content="⟳ Yenile"
                    Command="{Binding LoadReportCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Padding="15,8"
                    HorizontalAlignment="Right"/>

        </Grid>


        <!-- İSTATİSTİKLER -->

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,20">

            <!-- Bugünkü Ciro -->

            <Border Style="{StaticResource CardBorder}"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="BUGÜNKÜ CİRO"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding TodayTotalAmount, StringFormat={}{0:N2} ₺}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- Satış Sayısı -->

            <Border Style="{StaticResource CardBorder}"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="BUGÜNKÜ SATIŞ"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding TodaySalesCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- Toplam Ürün -->

            <Border Style="{StaticResource CardBorder}"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="AKTİF ÜRÜN"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding TotalProducts}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- Kritik Stok -->

            <Border Style="{StaticResource CardBorder}"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="KRİTİK STOK"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding CriticalStock}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>


        <!-- ALT KISIM -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- EN ÇOK SATANLAR -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}"
                    Margin="5"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🏆 En Çok Satan Ürünler"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding BestSellingProducts}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Ürün"
                                                Binding="{Binding ProductName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Adet"
                                                Binding="{Binding Quantity, StringFormat={}{0:N2}}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Ciro"
                                                Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₺}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- SON SATIŞLAR -->

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorder}"
                    Margin="5"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🧾 Son Satışlar"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentSales}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Fiş"
                                                Binding="{Binding SaleId}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Tarih"
                                                Binding="{Binding SaleDate, StringFormat={}{0:dd.MM HH:mm}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Tutar"
                                                Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₺}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Ödeme"
                                                Binding="{Binding PaymentType}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>