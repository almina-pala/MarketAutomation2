<Window x:Class="MarketAutomation2.Desktop.Views.CashRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MarketAutomation2.Desktop.Converters"
        Title="POS Kasa - Market Automation"
        Height="900"
        Width="1600"
        MinHeight="800"
        MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:CountToVisibilityConverter x:Key="CountToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============== HEADER ============== -->
        <Border Grid.Row="0" Style="{StaticResource AppHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Store Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White"
                            CornerRadius="10"
                            Width="52"
                            Height="52"
                            Margin="0,0,18,0">
                        <TextBlock Text="🛒"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StoreName}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding RegisterName}"
                                   FontSize="14"
                                   Foreground="#B3E5FC"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Date/Time & Cashier -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="{Binding CurrentDateTime}"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CashierName}"
                               FontSize="13"
                               Foreground="#B3E5FC"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== BARCODE SECTION ============== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,2"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📦 BARKOD GİR"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBox x:Name="txtBarcode"
                         Grid.Column="1"
                         Style="{StaticResource BarcodeTextBox}"
                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="txtBarcode_KeyDown"
                         Background="#FFFBEB"
                         BorderBrush="#FCD34D"
                         FontSize="28"
                         Padding="16,12"/>
            </Grid>
        </Border>

        <!-- ============== MAIN CONTENT AREA ============== -->
        <Grid Grid.Row="2" Margin="20,20,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="800"/>
                <ColumnDefinition Width="380" MaxWidth="450"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============== LEFT: CART SECTION ============== -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Border Background="#F5F5F5"
                            Padding="20,16"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="🛍 ALIŞVERIŞ SEPETİ"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Cart Grid -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgProducts"
                              ItemsSource="{Binding Cart}"
                              Style="{StaticResource ModernDataGrid}"
                              BorderThickness="0"
                              RowHeight="68"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barkod"
                                                Binding="{Binding Barcode}"
                                                Width="110"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ürün Adı"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="200"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Birim"
                                                Binding="{Binding Unit}"
                                                Width="60"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Miktar" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0">
                                            <Button Content="−"
                                                    Width="40"
                                                    Height="40"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="0"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                     Width="70"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     FontSize="14"
                                                     Margin="6,0"
                                                     Padding="6,4"
                                                     Style="{StaticResource ModernTextBox}"
                                                     PreviewKeyDown="QuantityTextBox_PreviewKeyDown"
                                                     PreviewTextInput="QuantityTextBox_PreviewTextInput"/>
                                            <Button Content="+"
                                                    Width="40"
                                                    Height="40"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="0"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Birim Fiyat"
                                                Binding="{Binding UnitPriceDisplay}"
                                                Width="100"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Toplam"
                                                Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₺}"
                                                Width="110"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="İşlem" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑"
                                                FontSize="16"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="2"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Cart Empty State -->
                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            Visibility="{Binding Cart.Count, Converter={StaticResource CountToVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="40">
                            <TextBlock Text="🛒"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Sepet Boş"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Ürün eklemek için barkod okutun"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cart Footer - Item Count -->
                    <Border Grid.Row="2"
                            Background="#F9FAFB"
                            Padding="20,12"
                            CornerRadius="0,0,10,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding Cart.Count, StringFormat=Toplam {0} Ürün}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ============== RIGHT: PAYMENT & SUMMARY PANEL ============== -->
            <StackPanel Grid.Column="1"
                        Orientation="Vertical">
                <StackPanel.Margin>0,0,0,0</StackPanel.Margin>

                <!-- Total Amount - PROMINENT -->
                <Border Style="{StaticResource CardBorder}"
                        Background="{StaticResource AccentBrush}"
                        Padding="24,28"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="TOPLAM TUTAR"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Opacity="0.9"/>
                        <TextBlock Text="{Binding Total, StringFormat={}{0:N2} ₺}"
                                   FontSize="44"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Payment Type Selection -->
                <Border Style="{StaticResource CardBorder}"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ÖDEME YÖNTEMİ"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel>
                            <Button Content="💰 NAKİT"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Padding="16,12"
                                    Height="45"
                                    Style="{StaticResource LargeSecondaryButton}"
                                    Command="{Binding SelectPaymentCommand}"
                                    CommandParameter="Cash"
                                    Margin="0,0,0,8"/>
                            <Button Content="💳 KART"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Padding="16,12"
                                    Height="45"
                                    Style="{StaticResource LargeSecondaryButton}"
                                    Command="{Binding SelectPaymentCommand}"
                                    CommandParameter="Card"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cash Payment Details -->
                <Border Style="{StaticResource CardBorder}"
                        Padding="16"
                        Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="ALINEN TUTAR"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding AmountReceived, StringFormat={}{0:N2}}"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Padding="12,10"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <Border Background="{StaticResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PARA ÜSTÜ"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Change, StringFormat={}{0:N2} ₺}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Checkout Button -->
                <Button Content="✓ SATIŞI TAMAMLA"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="16,16"
                        Height="60"
                        Style="{StaticResource LargePrimaryButton}"
                        Command="{Binding CompleteSaleCommand}"
                        Margin="0,8,0,0"/>

                <!-- Info Panel -->
                <Border Background="#E0F2FE"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{Binding Cart.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="ℹ Barkod okutun veya ürün ekleyin"
                               FontSize="12"
                               Foreground="#0369A1"
                               FontStyle="Italic"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
