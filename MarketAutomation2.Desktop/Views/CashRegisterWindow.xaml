<Window x:Class="MarketAutomation2.Desktop.Views.CashRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Market Automation - Cash Register"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0"
                Background="#1976D2"
                Padding="20">

            <TextBlock Text="MARKET AUTOMATION"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Barkod -->
        <StackPanel Grid.Row="1"
                    Margin="20">

            <TextBlock Text="Barkod"
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBox x:Name="txtBarcode"
                     Height="45"
                     FontSize="22"
                     Margin="0,10,0,0"
                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="txtBarcode_KeyDown"/>
        </StackPanel>

        <!-- Ürün Listesi -->
        <DataGrid Grid.Row="2"
                  Margin="20"
                  x:Name="dgProducts"
                  ItemsSource="{Binding Cart}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  FontSize="16" SelectionChanged="dgProducts_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Barkod"
                    Binding="{Binding Barcode}"
                    Width="170"/>

                <DataGridTextColumn
                    Header="Ürün"
                    Binding="{Binding Name}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Adet"
                    Binding="{Binding Quantity}"
                    Width="80"/>

                <DataGridTextColumn
                    Header="Birim Fiyat"
                    Binding="{Binding UnitPrice,StringFormat=N2}"
                    Width="120"/>

                <DataGridTextColumn
                    Header="Toplam"
                    Binding="{Binding TotalPrice,StringFormat=N2}"
                    Width="120"/>

                <DataGridTemplateColumn Header="İşlem" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Sil"
                    Width="60"
                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Alt Panel -->
        <Border Grid.Row="3"
                Background="White"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="220"/>

                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="TOPLAM"
                               FontWeight="Bold"
                               FontSize="18"/>
                    <TextBlock
                               Margin="0,5,0,0"
                               FontSize="16"
                               Foreground="Gray"
                               Text="{Binding PaymentType}"/>

                    <TextBlock
                               Text="{Binding Total, StringFormat={}{0:N2} ₺}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="DarkGreen"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Margin="10"
                        Height="60"
                        FontSize="18"
                        Content="NAKİT"
                        Command="{Binding SelectCashCommand}"/>

                <Button Grid.Column="3"
                        Margin="10"
                        Height="60"
                        FontSize="18"
                        Content="KART"
                        Command="{Binding SelectCardCommand}"/>

                <Button Grid.Column="4"
                        Margin="10"
                        Height="60"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#43A047"
                        Foreground="White"
                        Content="SATIŞI TAMAMLA"
                        Command="{Binding CompleteSaleCommand}"/>

            </Grid>

        </Border>

    </Grid>

</Window>