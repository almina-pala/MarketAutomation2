<Window x:Class="MarketAutomation2.Desktop.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün"
        Height="720"
        Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource AppHeader}">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barkod -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                    <TextBlock Text="Barkod" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Ürün Adı -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,16">
                    <TextBlock Text="Ürün Adı" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Marka -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Marka" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Birim -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Birim" Style="{StaticResource FormLabel}"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding UnitOptions}"
                              SelectedItem="{Binding Unit}"/>
                </StackPanel>

                <!-- Alış Fiyatı -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Alış Fiyatı (₺)" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Satış Fiyatı -->
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Satış Fiyatı (₺)" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Stok -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Stok" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Kritik Stok -->
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Kritik Stok" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding CriticalStock, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Kategori -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Kategori" Style="{StaticResource FormLabel}"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding CategoryId}"/>
                </StackPanel>

                <!-- Aktif -->
                <StackPanel Grid.Row="5" Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16">
                    <CheckBox Content="Aktif"
                              FontSize="15"
                              FontWeight="SemiBold"
                              IsChecked="{Binding IsActive}"
                              VerticalAlignment="Center"
                              Margin="0,24,0,8"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,0">
                <Button Content="✕ İptal"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="110"
                        Margin="0,0,12,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="✓ Kaydet"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="130"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
