<Window x:Class="MarketAutomation2.Desktop.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->

        <Border Grid.Row="0"
                Background="#1976D2"
                Padding="20">

            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

        </Border>


        <!-- FORM -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="30">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- BARKOD -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,15">

                    <TextBlock Text="Barkod"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding Barcode,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- ÜRÜN ADI -->

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,15">

                    <TextBlock Text="Ürün Adı"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding Name,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- MARKA -->

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,15">

                    <TextBlock Text="Marka"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding Brand,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- ALIŞ FİYATI -->

                <StackPanel Grid.Row="3"
                            Margin="0,0,0,15">

                    <TextBlock Text="Alış Fiyatı"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding PurchasePrice,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- SATIŞ FİYATI -->

                <StackPanel Grid.Row="4"
                            Margin="0,0,0,15">

                    <TextBlock Text="Satış Fiyatı"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding SalePrice,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- STOK -->

                <StackPanel Grid.Row="5"
                            Margin="0,0,0,15">

                    <TextBlock Text="Stok"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding Stock,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- KRİTİK STOK -->

                <StackPanel Grid.Row="6"
                            Margin="0,0,0,15">

                    <TextBlock Text="Kritik Stok"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Height="38"
                             Margin="0,5,0,0"
                             FontSize="16"
                             Text="{Binding CriticalStock,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- BİRİM -->

                <StackPanel Grid.Row="7">

                    <TextBlock Text="Birim"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <ComboBox Height="38"
                              Margin="0,5,0,0"
                              FontSize="16"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding Unit}">

                        <ComboBoxItem Content="Adet"
                                      Tag="Adet"/>

                        <ComboBoxItem Content="Kilogram"
                                      Tag="Kg"/>

                        <ComboBoxItem Content="Litre"
                                      Tag="Litre"/>

                        <ComboBoxItem Content="Gram"
                                      Tag="Gram"/>

                    </ComboBox>

                </StackPanel>

                <!-- KATEGORİ -->

                <StackPanel Grid.Row="8">

                    <TextBlock Text="Kategori"
               FontWeight="Bold"
               FontSize="15"/>

                    <ComboBox Height="38"
              Margin="0,5,0,0"
              FontSize="16"
              ItemsSource="{Binding Categories}"
              DisplayMemberPath="Name"
              SelectedValuePath="Id"
              SelectedValue="{Binding CategoryId}"/>

                </StackPanel>

            </Grid>

        </ScrollViewer>


        <!-- ALT BUTONLAR -->

        <Border Grid.Row="2"
                Background="White"
                Padding="20">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="İptal"
                        Width="110"
                        Height="45"
                        Margin="0,0,10,0"
                        FontSize="16"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Kaydet"
                        Width="130"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#43A047"
                        Foreground="White"
                        Command="{Binding SaveCommand}"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>